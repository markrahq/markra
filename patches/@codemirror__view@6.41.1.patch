index 0a2374effcd135ba9be38756ec0244997344afcb..7425a7ed9d78162213b25c53e976d384e05c11ff 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -670,8 +670,9 @@ class DOMSelectionState {
     }
 }
 let preventScrollSupported = null;
-// Safari 26 breaks preventScroll support
-if (browser.safari && browser.safari_version >= 26)
+// Safari 26 breaks preventScroll support. WKWebView omits Version/ from
+// its user agent, so an unknown Safari version needs the same fallback.
+if (browser.safari && (browser.safari_version >= 26 || browser.safari_version == 0))
     preventScrollSupported = false;
 // Feature-detects support for .focus({preventScroll: true}), and uses
 // a fallback kludge when not supported.
